# TradeMaster Server Environment Variables
# Copy this file to .env and fill in the values

# Server
NODE_ENV=development
PORT=3000
HOST=0.0.0.0

# Database (PostgreSQL)
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=your_password_here
DB_NAME=trademaster

# JWT Authentication
# IMPORTANT: In production, these MUST be set to secure random values
# Generate with: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=
JWT_EXPIRES_IN=7d
JWT_REFRESH_SECRET=
JWT_REFRESH_EXPIRES_IN=30d

# CORS
FRONTEND_URL=http://localhost:5173

# File Uploads
UPLOAD_DIR=uploads
MAX_FILE_SIZE=5242880

# Rate Limiting
# 15 minutes in milliseconds
RATE_LIMIT_WINDOW_MS=900000
# General API requests per IP per window (sufficient for map + lists + images)
RATE_LIMIT_MAX=5000
# Auth endpoint requests per IP per window (login/signup/refresh)
AUTH_RATE_LIMIT_MAX=100

# Observability
# Log level: debug | info | warn | error (defaults to debug in development, info in production)
LOG_LEVEL=debug
# Set to true to log every Sequelize SQL query (very noisy; default false)
LOG_DB_QUERIES=false

# OpenTelemetry
# Set to true to export traces/metrics to an OTLP collector (e.g. Grafana Alloy)
OTEL_ENABLED=false
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
OTEL_SERVICE_NAME=trademaster-server

# Error tracking (GlitchTip / Sentry)
# Leave empty to disable. Example GlitchTip DSN:
# SENTRY_DSN=http://projectId@localhost:8000/api/projectId/security/?glitchtip_key=xxx
SENTRY_DSN=
SENTRY_TRACES_SAMPLE_RATE=0.1
SENTRY_PROFILES_SAMPLE_RATE=0.0
