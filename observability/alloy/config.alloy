// Grafana Alloy configuration for TradeMaster observability.
// Receives OTLP (gRPC + HTTP) and routes signals to Loki, Tempo, and Mimir.

otelcol.receiver.otlp "default" {
  grpc {
    endpoint = "0.0.0.0:4317"
  }
  http {
    endpoint = "0.0.0.0:4318"
  }
  output {
    metrics = [otelcol.processor.batch.default.input]
    logs    = [otelcol.processor.batch.default.input]
    traces  = [otelcol.processor.batch.default.input]
  }
}

otelcol.processor.batch "default" {
  output {
    metrics = [otelcol.exporter.prometheus.mimir.input]
    logs    = [otelcol.exporter.loki.loki.input]
    traces  = [otelcol.exporter.otlp.tempo.input]
  }
}

// Traces -> Tempo
otelcol.exporter.otlp "tempo" {
  client {
    endpoint = "tempo:9095"
    tls {
      insecure = true
    }
  }
}

// Metrics -> Mimir (remote_write)
otelcol.exporter.prometheus "mimir" {
  forward_to = [prometheus.remote_write.mimir.receiver]
}

prometheus.remote_write "mimir" {
  endpoint {
    name = "mimir"
    url  = "http://mimir:3300/api/v1/push"
  }
}

// Logs -> Loki
otelcol.exporter.loki "loki" {
  forward_to = [loki.write.default.receiver]
}

loki.write "default" {
  endpoint {
    name = "loki"
    url  = "http://loki:3100/loki/api/v1/push"
  }
}

// Optional: tail Docker container logs and send to Loki
// Requires mounting /var/lib/docker/containers into the Alloy container.
loki.source.docker "default" {
  host       = "unix:///var/run/docker.sock"
  targets    = []
  forward_to = [loki.write.default.receiver]
  labels = {
    job = "docker",
  }
}
