# TradeMaster Web Environment Variables
# Copy this file to .env and fill in the values

# API Base URL
VITE_API_BASE_URL=http://localhost:3000

# Error tracking (GlitchTip / Sentry)
# Leave empty to disable. Example GlitchTip DSN:
# VITE_SENTRY_DSN=http://projectId@localhost:8000/api/projectId/security/?glitchtip_key=xxx
VITE_SENTRY_DSN=
VITE_SENTRY_TRACES_SAMPLE_RATE=0.1

# Session replay / product analytics (self-hosted PostHog)
# Leave empty to disable.
VITE_POSTHOG_KEY=
VITE_POSTHOG_HOST=http://localhost:8001
VITE_POSTHOG_REPLAY_SAMPLE_RATE=0.0
